{
  "name": "sandbox-e2e-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright end-to-end tests covering SandboxApi, SandboxSpaApp and SandboxPrototypeWeb.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test --project=api",
    "test:spa": "playwright test --project=spa",
    "test:prototype": "playwright test --project=prototype",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:1337/app/",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
