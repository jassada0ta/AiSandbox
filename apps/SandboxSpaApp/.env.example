# Copy to `.env.local` to override.

# Base URL used for API calls. Leave empty to use relative URLs, which is what
# production needs because the SPA is served from the Strapi origin, and what
# dev needs because vite.config.js proxies /api and /graphql.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api, /graphql and /uploads.
VITE_DEV_API_PROXY_TARGET=http://localhost:1337

VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173
